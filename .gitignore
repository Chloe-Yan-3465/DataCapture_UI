*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Runtime logs and captured data
*.log
BLE-TimeSync/logs/*
!BLE-TimeSync/logs/.gitkeep
